# Dashboard-Passwort (Produktion: mind. 12 Zeichen, besser 20+ / Passphrase)
APP_PASSWORD=

# Zufälliger Schlüssel zum Signieren der Login-Cookies (Produktion: Pflicht, mind. 32 Zeichen)
# Erzeugen mit:  openssl rand -base64 48
SESSION_SECRET=

# Upstash Redis (auf Vercel Pflicht; lokal optional → Fallback .data/finanz.json)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
